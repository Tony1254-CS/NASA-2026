# TRACE Server Environment Configuration

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trace_db

# Supabase Credentials (SERVER ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NASA Earthdata Credentials (SERVER ONLY)
# Never expose Earthdata credentials to browser or client
EARTHDATA_USERNAME=your-earthdata-username
EARTHDATA_PASSWORD=your-earthdata-password
EARTHDATA_TOKEN=your-earthdata-bearer-token

# NASA Service Base Endpoints
CMR_BASE_URL=https://cmr.earthdata.nasa.gov
ASF_API_BASE_URL=https://api.daac.asf.alaska.edu

# Server Runtime Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=trace_dev_secret_key_change_in_production_32bytes_min
