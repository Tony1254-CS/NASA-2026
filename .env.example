# TRACE Central Environment Variables

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trace_db

# Supabase Storage & Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER ONLY - Never expose service role key to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# API & Frontend URLs
NEXT_PUBLIC_API_URL=https://traceserver-production.up.railway.app
NEXT_PUBLIC_APP_URL=https://traceclient-production.up.railway.app

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
